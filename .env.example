# Banco (opcional em dev: sem DATABASE_URL o site usa os dados de demonstração)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/veredito

# IA (fase 2) — consultor e RAG
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_DAILY_BUDGET_USD=20
EMBEDDINGS_PROVIDER=hashing        # hashing (dev/test) | voyage
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

# Afiliados (preencher após aprovação nos programas)
AMAZON_ASSOCIATES_TAG=
MERCADOLIVRE_AFFILIATE_TOOL_ID=
AWIN_PUBLISHER_ID=

# Analytics
NEXT_PUBLIC_GA4_ID=

# Worker → site (revalidação de cache após coleta de preços). Token aleatório com 32+ caracteres.
WEB_URL=http://localhost:3000
INTERNAL_TOKEN=

# Assinatura dos links de e-mail (confirmar, gerenciar, descadastrar). Obrigatório em produção, 32+ caracteres aleatórios.
APP_SECRET=
# E-mail: console (desenvolvimento, nada é enviado) | resend
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Veredito <alertas@veredito.example>"
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postback de conversões por rede (HMAC-SHA256 do corpo no cabeçalho x-signature). Um por programa.
POSTBACK_SECRET_AWIN=
